# =========================================================
# Настройки Docker Compose — скопируйте в .env и поправьте
# =========================================================

# Первый вход в веб-интерфейс. Используется один раз — пока
# пользователь не создан (data/auth.json). Пароль — не короче
# 8 символов. Потом строку можно удалить; сменить пароль:
#   sudo docker compose exec -u nbm nbm python main.py --create-user
NBM_ADMIN_USER=admin
NBM_ADMIN_PASSWORD=

# Версия образа: latest — последняя; 2.0.0 — точная (для отката)
NBM_VERSION=latest

# Порт веб-интерфейса на сервере. 127.0.0.1:8080 — только локально
# (например, за обратным прокси)
NBM_LISTEN=8080

# Папка данных на сервере
NBM_DATA=./nbm

# Владелец файлов в папке данных (id -u / id -g на сервере)
NBM_UID=1000
NBM_GID=1000

# Часовой пояс — для расписания бэкапов и времени в журнале
TZ=Europe/Kyiv

# Обратный прокси перед программой (адрес или *), если есть
NBM_TRUSTED_PROXIES=

# HTTPS без прокси. Проще — Настройки → HTTPS в интерфейсе; тогда оставьте
# пустым. Или сертификат и ключ PEM в nbm/data/ (путь от data/), например
# tls/cert.pem и tls/key.pem — важнее настройки из интерфейса.
# off — выключить HTTPS при любой настройке (если интерфейс не открывается)
NBM_TLS_CERT=
NBM_TLS_KEY=

# Проверка новой версии раз в сутки (HEAD-запрос к github.com).
# 0 — выключить; пусто — как в Настройки → Общие (по умолчанию включена)
NBM_UPDATE_CHECK=

# Вариант Б — сборка из исходников на сервере (раскомментируйте)
#COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
