# =========================================================
# Настройки Docker Compose — скопируйте в .env и поправьте
# =========================================================

# Первый вход в веб-интерфейс. Используется один раз — пока
# пользователь не создан (data/auth.json). Потом пароль меняется
# в программе, а строку можно удалить.
NBM_ADMIN_USER=admin
NBM_ADMIN_PASSWORD=

# Версия образа: latest — последняя; 2.0.0 — точная (для отката)
NBM_VERSION=latest

# Порт веб-интерфейса на сервере. 127.0.0.1:8080 — только локально
# (например, за обратным прокси)
NBM_LISTEN=8080

# Папка данных на сервере
NBM_DATA=./nbm

# Владелец файлов в папке данных (id -u / id -g на сервере)
NBM_UID=1000
NBM_GID=1000

# Часовой пояс — для расписания бэкапов и времени в журнале
TZ=Europe/Kyiv

# Обратный прокси перед программой (адрес или *), если есть
NBM_TRUSTED_PROXIES=

# Вариант Б — сборка из исходников на сервере (раскомментируйте)
#COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
