                "uuid": "44112107ecfa4bef814f041ac875a6c9",
                "template": "Network Backup Manager by HTTP",
                "name": "Network Backup Manager by HTTP",
                "description": "Network Backup Manager: состояние бэкапов сетевых устройств через HTTP API (/api/status, /api/health).\n\nМакросы узла: {$NBM.URL} — адрес программы без / в конце (например http://192.0.2.10:8080), {$NBM.TOKEN} — токен мониторинга (Настройки → Мониторинг).",
                "groups": [
                    {
                        "name": "Templates/Applications"
                    }
                ],
                "items": [
                    {
                        "uuid": "90e874bc48214c0c927cafb7cdc3142b",
                        "name": "NBM: Получить состояние",
                        "type": "HTTP_AGENT",
                        "key": "nbm.status.get",
                        "delay": "{$NBM.INTERVAL}",
                        "history": "0",
                        "trends": "0",
                        "value_type": "TEXT",
                        "timeout": "15s",
                        "url": "{$NBM.URL}/api/status",
                        "status_codes": "200",
                        "tags": [
                            {
                                "tag": "component",
                                "value": "raw"
                            }
                        ],
                        "headers": [
                            {
                                "name": "Authorization",
                                "value": "Bearer {$NBM.TOKEN}"
                            }
                        ]
                    },
